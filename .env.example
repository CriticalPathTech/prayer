# ============================================================
# Local development env.
# ============================================================
# Copy this file to `.env` at the repo root for local dev.
# Each section below lists the variables that a specific
# workflow needs. On Railway, each service gets a different
# subset — see docs/deployment.md.
#
# Dev modes:
#   Mode A (Full Docker):  docker compose up && pnpm bootstrap
#   Mode B (Remote API):   PROD_API_URL=https://api-staging.prays.online pnpm dev:remote
#   Mode C (Native local): docker compose up -d db gotrue && pnpm dev
#
# Values below are Mode A/C defaults (local GoTrue + local Postgres).
# Mode B overrides are noted inline where they differ.
# ============================================================

# ---- api server (local dev) ----
# Used by: apps/api (server.ts)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/prayer_dev
# AUTH_URL is the base URL of the auth provider (GoTrue / hosted Supabase / etc).
# Mode A/C: local GoTrue container fronted by the gotrue-proxy on host :9999.
AUTH_URL=http://localhost:9999
AUTH_JWKS_URL=http://localhost:9999/.well-known/jwks.json
# Mode B: point at a hosted Supabase project instead:
#   AUTH_URL=https://<staging-project>.supabase.co
#   AUTH_JWKS_URL=https://<staging-project>.supabase.co/auth/v1/.well-known/jwks.json
CORS_ORIGIN=http://localhost:5173
PORT=3001
NODE_ENV=development
LOG_LEVEL=debug
GIT_SHA=local-dev

# ---- bootstrap / seed script (local only) ----
# Used by: pnpm bootstrap  (seeds 5 dev users, 10 posts, 6 comments)
# Mode A/C: dev service-role JWT signed with the RS256 key baked into docker-compose.yml
# Never reuse this key in production; never set AUTH_ADMIN_KEY on Railway (bypasses RLS).
AUTH_ADMIN_KEY=eyJhbGciOiJSUzI1NiIsImtpZCI6ImRldi1yczI1Ni1rZXktMSJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UtZGVtbyIsImV4cCI6MTk4MzgxMjk5NiwiaWF0IjoxNzc3MTc3NTg0fQ.H-Q5rLfWfXlxsvAxSOYqlRpV3szyvPjNAZNoAoj64QvHKqQ7tsLrwhdJkhcGpUnZXKjdPMzrYl9Mf-VVXh9qFrsW1N-2p24lRuw0_fbCfuHmIIXPTzWx5z1EKldSrP65YqFuo1j5ckmW1vkoAImlWbLPrlN9V_ob2IWPPGwTzuwpvfwGmQ_d8ysDiKnkhCFBG6kdDECD8VYxBpZ9odDVKmTFad_vexgFIDrhKcwfRMUbJoN1X_DLnx5Lrb5XfzwEaLjt8cExjQ8a97T2r6pi__D3JhWb0Z84KVnUNziPYBrLQWfNfqiklJq8V58jdP7ItEHcLJ7bQlkztJPN3NdEDg
# Mode B: replace with your hosted Supabase service-role key

# ---- storage (S3-compatible) — used by api for avatar upload/serve ----
# Mode A / Mode C (local MinIO via docker-compose):
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=avatars
S3_ACCESS_KEY=prayer-dev-local
S3_SECRET_KEY=prayer-dev-local-secret
S3_FORCE_PATH_STYLE=true
STORAGE_PUBLIC_URL_BASE=http://localhost:9000/avatars

# Mode B (local web against remote API): leave the above unset; the
# remote API uses its own production storage credentials.

# Production wiring (for reference — set on Railway, NOT in local .env):
# S3_ENDPOINT=https://<project>.supabase.co/storage/v1/s3
# S3_BUCKET=avatars
# S3_ACCESS_KEY=<from Supabase dashboard → Storage → S3 Connection>
# S3_SECRET_KEY=<from Supabase dashboard → Storage → S3 Connection>
# S3_FORCE_PATH_STYLE=true
# STORAGE_PUBLIC_URL_BASE=https://<project>.supabase.co/storage/v1/object/public/avatars

# ---- tests (local + CI) ----
# Used by: apps/api/test, packages/db/test
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/prayer_test

# ---- web (Vite; must be prefixed VITE_) ----
# Used by: apps/web build + dev
VITE_API_URL=http://localhost:3001
# Mode A/C: local GoTrue container fronted by gotrue-proxy
VITE_AUTH_URL=http://localhost:9999
# Mode A/C: dev anon JWT signed with the RS256 key baked into docker-compose.yml
# Local-dev-only — never reuse in production.
VITE_AUTH_ANON_KEY=eyJhbGciOiJSUzI1NiIsImtpZCI6ImRldi1yczI1Ni1rZXktMSJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlLWRlbW8iLCJleHAiOjE5ODM4MTI5OTYsImlhdCI6MTc3NzE3NzU4NH0.L8OxBc_6q3OKq8Tpi2nsWlAdqxWqarXE3JehIhtS92PPinOU6SeP6C94VecMNj44OZcuQcZ5uRm2D_bCM3KBFCPeTL8W13fWhQd1ttTPlbZiCvflwd3EXopKDnTFJqrGLyYDvHx_SaOxbDBJHigZoaeJRTATo-OlvL_joUE6Ub93m3iK7JTY5iME2pH0qqEAGstTX3WMR-Mrx8hfe4KoREFD4QMY8iJghuJZgMDybZeAR0tWqMzem9Oecu8A93YEEHs-6RAOn_ATVOEzq_x6ptm1EqGOmoC5sYz_r2GTIN4CaXJbjFGzHI9rsNUHigHSaYjpTj2XHCehCMJxM2avAw
