{
  "name": "prayer",
  "version": "1.5.1",
  "private": true,
  "license": "Elastic-2.0",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm -r --parallel dev",
    "dev:remote": "pnpm --filter @prayer/web dev:remote",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --build",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @prayer/db migrate:up",
    "db:migrate:test": "pnpm --filter @prayer/db migrate:up:test",
    "bootstrap": "pnpm --filter @prayer/db bootstrap",
    "admin:create-org": "pnpm --filter @prayer/db admin:create-org"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/node": "^24",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "eslint-plugin-import": "^2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7",
    "eslint-plugin-react-hooks": "^5",
    "husky": "^9",
    "prettier": "^3",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.65.0"
  },
  "pnpm": {
    "overrides": {
      "@types/node": "^24",
      "qs": "^6.15.2"
    }
  }
}
