{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @prayer/shared build && pnpm --filter @prayer/db build && pnpm --filter @prayer/api build",
    "watchPatterns": [
      "/apps/api/src/**",
      "/apps/api/**",
      "/packages/shared/**",
      "/packages/db/**",
      "/pnpm-lock.yaml",
      "/package.json",
      "/tsconfig.base.json",
      "/railway/api.json"
    ]
  },
  "deploy": {
    "startCommand": "node apps/api/dist/server.js",
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
