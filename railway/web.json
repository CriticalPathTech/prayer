{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @prayer/shared build && pnpm --filter @prayer/web build",
    "watchPatterns": [
      "/apps/web/src/**",
      "/apps/web/**",
      "/packages/shared/**",
      "/pnpm-lock.yaml",
      "/package.json",
      "/tsconfig.base.json",
      "/railway/web.json"
    ]
  },
  "deploy": {
    "startCommand": "pnpm dlx serve -s apps/web/dist -l $PORT",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
